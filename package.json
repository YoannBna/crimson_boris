{
  "name": "crimson-boris",
  "productName": "Crimson Boris",
  "version": "2.1.1",
  "description": "Noyau analytique et executif — tableau de bord de bureau local",
  "author": "Crimson Boris",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "dev:web": "vite --config vite.web.config.ts",
    "dist:win": "npm run build && electron-builder --win --x64 --arm64",
    "dist:all": "npm run build && electron-builder --mac --win",
    "release": "npm run build && electron-builder --mac --win --publish always",
    "test": "npm run build && electron out/main/index.js --hidden"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
